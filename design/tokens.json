{
  "$name": "Postcrate design tokens",
  "$palette": "Ink and paper",
  "$notes": "Single source of truth. Map to Flutter ThemeData / ThemeExtension; never hardcode these values in widgets. No borders on cards, fields or buttons: layers are separated by fill shade only.",

  "color": {
    "light": {
      "page": "#F2F2F2",
      "card": "#FFFFFF",
      "fieldOnCard": "#F0F0F0",
      "fieldOnPage": "#E6E6E6",
      "sheet": "#FFFFFF",

      "textPrimary": "#111111",
      "textSecondary": "#4A4A4A",
      "textTertiary": "#6E6E6E",
      "textDisabled": "#111111/38%",

      "accent": "#111111",
      "primaryFill": "#111111",
      "onPrimary": "#FFFFFF",
      "secondaryFill": "#F0F0F0",
      "onSecondary": "#111111",

      "selectedTint": "#111111/8%",
      "listSeparator": "#111111/6%",

      "success": "#1E7B45",
      "warning": "#8A5A00",
      "danger": "#B3261E",
      "dangerFill": "#B3261E",
      "onDanger": "#FFFFFF",

      "switchOff": "#E6E6E6",
      "switchOn": "#111111",
      "switchThumb": "#FFFFFF",

      "appIconBackground": "#F4F4F4",
      "appIconMark": "#111111"
    },
    "dark": {
      "page": "#0A0A0A",
      "card": "#1A1A1A",
      "fieldOnCard": "#262626",
      "fieldOnPage": "#1F1F1F",
      "sheet": "#1A1A1A",

      "textPrimary": "#F2F2F2",
      "textSecondary": "#A8A8A8",
      "textTertiary": "#939393",
      "textDisabled": "#F2F2F2/38%",

      "accent": "#F2F2F2",
      "primaryFill": "#3A3A3A",
      "onPrimary": "#FFFFFF",
      "secondaryFill": "#262626",
      "onSecondary": "#F2F2F2",

      "selectedTint": "#F2F2F2/8%",
      "listSeparator": "#F2F2F2/6%",

      "success": "#5FC98A",
      "warning": "#E0B252",
      "danger": "#FF8A80",
      "dangerFill": "#B3261E",
      "onDanger": "#FFFFFF",

      "switchOff": "#262626",
      "switchOn": "#F2F2F2",
      "switchThumb": "#8C8C8C",

      "appIconBackground": "#141414",
      "appIconMark": "#F2F2F2"
    }
  },

  "corner": {
    "$shape": "Continuous corners (superellipse). Flutter: RoundedSuperellipseBorder / ClipRSuperellipse with these radii.",
    "control": 10,
    "navTile": 12,
    "card": 16,
    "sheet": 22,
    "phoneFrame": 34,
    "appIconRatio": 0.2237
  },

  "spacing": {
    "xxs": 4,
    "xs": 8,
    "sm": 12,
    "md": 16,
    "lg": 20,
    "xl": 24,
    "xxl": 32,
    "xxxl": 40,
    "screenGutter": 16,
    "cardPadding": 14,
    "sectionGap": 20
  },

  "size": {
    "touchTarget": 44,
    "navTile": 44,
    "navIcon": 22,
    "logoInApp": 26,
    "fieldHeight": 44,
    "buttonHeight": 44,
    "mediaThumb": 64
  },

  "typography": {
    "$font": "System only: San Francisco on iOS/macOS, Roboto on Android, Segoe UI on Windows, system UI on Linux. No monospace anywhere.",
    "$rule": "Selected or active states never change weight or size, only color or background.",
    "largeTitle": { "size": 34, "weight": 700, "lineHeight": 41 },
    "title1": { "size": 28, "weight": 700, "lineHeight": 34 },
    "title2": { "size": 22, "weight": 600, "lineHeight": 28 },
    "title3": { "size": 20, "weight": 600, "lineHeight": 25 },
    "headline": { "size": 17, "weight": 600, "lineHeight": 22 },
    "body": { "size": 17, "weight": 400, "lineHeight": 22 },
    "callout": { "size": 16, "weight": 400, "lineHeight": 21 },
    "subheadline": { "size": 15, "weight": 400, "lineHeight": 20 },
    "footnote": { "size": 13, "weight": 400, "lineHeight": 18 },
    "caption1": { "size": 12, "weight": 400, "lineHeight": 16 },
    "caption2": { "size": 11, "weight": 400, "lineHeight": 13 }
  },

  "motion": {
    "$reducedMotion": "When the OS asks for reduced motion, replace movement with a 150 ms cross-fade.",
    "standard": { "curve": [0.32, 0.72, 0, 1], "durationMs": 420 },
    "quick": { "curve": [0.32, 0.72, 0, 1], "durationMs": 240 },
    "fade": { "curve": [0.25, 0.1, 0.25, 1], "durationMs": 200 },
    "spring": { "mass": 1, "stiffness": 380, "damping": 34 }
  },

  "interaction": {
    "$rule": "No hover, focus ring, ripple, splash or press highlight on any control. Keep only selected, disabled, invalid and loading states.",
    "splash": "none",
    "hover": "none",
    "focusRing": "none",
    "pressFeedback": "none"
  },

  "bottomBar": {
    "$rule": "No top border. Solid, slightly darker toward the bottom edge, fading upward into content with a smootherstep curve. Home is the center tab and selected on launch. All tabs share one size and baseline.",
    "fadeHeight": 28,
    "bottomDarken": "4%",
    "tabs": ["library", "home", "backup"]
  }
}
